[Unit]
Description=AgentGate API Gateway (Python)
Documentation=https://gitcode.com/kenhkl/AgentGate
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__

# 启动命令（V1 分析服务）
ExecStart=__PROJECT_DIR__/venv/bin/agent-gate server --host 0.0.0.0 --port 9100

# 重启策略
Restart=on-failure
RestartSec=5
StartLimitInterval=0

# 日志
StandardOutput=append:__PROJECT_DIR__/logs/agent_gate.log
StandardError=append:__PROJECT_DIR__/logs/agent_gate_error.log

# 环境变量（如果需要）
# Environment=ANTHROPIC_API_KEY=your-key-here

# 优雅关闭
TimeoutStopSec=10
KillSignal=SIGTERM
KillMode=process

[Install]
WantedBy=multi-user.target

[Unit]
Description=AgentGate API Gateway (Python)
Documentation=https://gitcode.com/kenhkl/AgentGate
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__

# 启动命令（需要指定 upstream）
ExecStart=__PROJECT_DIR__/venv/bin/agent-gate gateway --upstream __UPSTREAM_URL__

# 重启策略
Restart=on-failure
RestartSec=5
StartLimitInterval=0

# 日志
StandardOutput=append:__PROJECT_DIR__/logs/gateway.log
StandardError=append:__PROJECT_DIR__/logs/gateway_error.log

# 环境变量（如果需要）
# Environment=ANTHROPIC_API_KEY=your-key-here

# 优雅关闭
TimeoutStopSec=10
KillSignal=SIGTERM
KillMode=process

[Install]
WantedBy=multi-user.target
